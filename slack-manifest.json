{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "elg-kit",
    "description": "Employee-Led Growth: authentic technical perspectives, peer reviews, and instant attribution.",
    "background_color": "#eb6c36",
    "long_description": "Developer-first rails for Employee-Led Growth (ELG). Empowers technical teams to share engineering milestones authentically, bypass social algorithmic link penalties with comment-first edge attribution, request pre-publish peer reviews, and generate 1-click personal resharing shortlinks."
  },
  "features": {
    "bot_user": {
      "display_name": "elg-kit",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/link",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Generate your personal attributed edge shortlink for any URL",
        "usage_hint": "<destination-url>",
        "should_escape": false
      },
      {
        "command": "/angles",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Browse recent company milestone angles (Builder, GTM, Talent, Visionary, Product)",
        "usage_hint": "[milestone-id]",
        "should_escape": false
      },
      {
        "command": "/showcase",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Share published post to #showcase with thread-only discussion rule",
        "usage_hint": "<post-url> [reflection]",
        "should_escape": false
      },
      {
        "command": "/elg",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Manage ELG voice samples, weekly impact stats, and snooze preferences",
        "usage_hint": "sample | stats | snooze | opt-out",
        "should_escape": false
      },
      {
        "command": "/harvest",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Harvest high-signal quotes from a thread into a ready-to-share post draft",
        "usage_hint": "[thread_ts]",
        "should_escape": false
      },
      {
        "command": "/guard",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Pre-publish DLP token and secret scanner",
        "usage_hint": "[text to inspect]",
        "should_escape": false
      },
      {
        "command": "/suggest",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Mine recent conversations for high-signal technical post drafts",
        "usage_hint": "",
        "should_escape": false
      },
      {
        "command": "/impact",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Private report of verified reads, bot-filtered clicks, and attributed pipeline",
        "usage_hint": "[7 | 30 | 90]",
        "should_escape": false
      },
      {
        "command": "/repost",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Adapt technical post to GTM, Talent, or Product perspective",
        "usage_hint": "[quote_or_url] --role [gtm|talent|product]",
        "should_escape": false
      },
      {
        "command": "/rebound",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Generate a 90/180-day production retrospective post draft",
        "usage_hint": "[release-name] --days [90|180]",
        "should_escape": false
      },
      {
        "command": "/kudos",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Transform peer craft praise into an authentic engineering spotlight",
        "usage_hint": "@colleague [technical context]",
        "should_escape": false
      },
      {
        "command": "/ama",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Synthesize architecture Q&A into an engineering FAQ post draft",
        "usage_hint": "[question or thread_ts]",
        "should_escape": false
      },
      {
        "command": "/brief",
        "url": "https://${APP_DOMAIN}/api/slack/events",
        "description": "Compile an executive milestone digest memo for leadership and investors",
        "usage_hint": "[period, e.g. Q3 2026]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "commands",
        "channels:history",
        "groups:history",
        "im:history",
        "im:write",
        "im:read",
        "users:read",
        "users:read.email",
        "reactions:read",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://${APP_DOMAIN}/api/slack/events",
      "bot_events": [
        "app_mention",
        "message.im",
        "message.channels",
        "reaction_added"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://${APP_DOMAIN}/api/slack/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
