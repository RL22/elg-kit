# ==============================================================================
# elg-kit Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Inference Layer (100% Provider-Agnostic)
# ------------------------------------------------------------------------------
# Provider options:
#   - openrouter  : Universal gateway (Anthropic, Google, OpenAI, DeepSeek, Meta)
#   - anthropic   : Direct Anthropic API
#   - openai      : Direct OpenAI API
#   - groq        : Ultra-low latency LPU inference
#   - deepseek    : Direct DeepSeek API
#   - ollama      : Local private inference
#   - gateway     : Vercel AI Gateway
AI_PROVIDER=openrouter

# Recommended 2026 Models:
#   OpenRouter (Recommended Flagships):
#     - anthropic/claude-3.7-sonnet       (Hybrid reasoning, top-tier drafting)
#     - google/gemini-2.5-pro             (1M+ context, multi-perspective synthesis)
#     - google/gemini-2.5-flash           (Sub-second response, high-throughput)
#     - deepseek/deepseek-chat            (Exceptional price-performance)
#     - openai/gpt-5.6-sol                (Frontier agentic workhorse)
#     - meta-llama/llama-3.3-70b-instruct (Open-weight standard)
#   Direct Providers:
#     - Anthropic : claude-3-7-sonnet-latest, claude-opus-5
#     - OpenAI    : gpt-5.6-sol, o3-mini
#     - Groq      : llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b
#     - Ollama    : qwen2.5:32b, llama3.3:70b
AI_MODEL_ID=anthropic/claude-3.7-sonnet

# Provider API Keys (Set the one matching your AI_PROVIDER)
OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GROQ_API_KEY=gsk_...
DEEPSEEK_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional Custom Base URL and Temperature
# (Note: Temperature is automatically ignored for reasoning models like o1/o3/r1)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_TEMPERATURE=0.65

# ------------------------------------------------------------------------------
# 2. Slack Integration Credentials
# ------------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
SLACK_STAGING_CHANNEL_ID=C0123456789
PORT=3000

# ------------------------------------------------------------------------------
# 3. Edge Redirect & Attribution Rails (Cloudflare Worker)
# ------------------------------------------------------------------------------
EDGE_REDIRECT_BASE_URL=go.company.com
EDGE_REDIRECT_ALLOWLIST_DOMAINS=company.com,docs.company.com,blog.company.com,github.com

# ------------------------------------------------------------------------------
# 4. Ingestion Webhook Signature
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=your_hmac_sha256_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. Storage / State (Vercel KV or Upstash Redis)
# ------------------------------------------------------------------------------
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
