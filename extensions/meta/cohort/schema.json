{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CohortRosterState",
  "description": "Output schema for advocate roster management and tag-based signal routing",
  "type": "object",
  "required": ["totalMembers", "activeAdvocates", "roster"],
  "properties": {
    "totalMembers": { "type": "integer", "minimum": 0 },
    "activeAdvocates": { "type": "integer", "minimum": 0 },
    "roster": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["userId", "memberSlug", "tags", "weeklyQuota", "sharesThisWeek", "active"],
        "properties": {
          "userId": { "type": "string" },
          "memberSlug": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string", "enum": ["infra", "ai", "security", "frontend", "gtm", "data", "mobile"] }
          },
          "weeklyQuota": { "type": "integer", "minimum": 1, "maximum": 5 },
          "sharesThisWeek": { "type": "integer", "minimum": 0 },
          "active": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
