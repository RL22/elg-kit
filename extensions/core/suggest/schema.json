{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuggestMinedInsights",
  "description": "Output schema for conversational Slack history mining and Friday draft suggestions",
  "type": "object",
  "required": ["userId", "analyzedMessageCount", "suggestions"],
  "properties": {
    "userId": { "type": "string" },
    "analyzedMessageCount": { "type": "integer", "minimum": 0 },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["threadTs", "channelId", "signalScore", "topicSummary", "draft", "rawSnippet"],
        "properties": {
          "threadTs": { "type": "string" },
          "channelId": { "type": "string" },
          "signalScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "topicSummary": { "type": "string" },
          "rawSnippet": { "type": "string" },
          "draft": {
            "type": "object",
            "required": ["postBody", "firstComment", "wordCount"],
            "properties": {
              "postBody": { "type": "string" },
              "firstComment": { "type": "string" },
              "wordCount": { "type": "integer", "minimum": 150, "maximum": 200 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
